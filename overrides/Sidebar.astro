---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';
import config from 'virtual:bogoware-theme/config';
---

<div data-bw-style={config.mode}>
  <Default {...Astro.props}><slot /></Default>
</div>

<style>
  :global([aria-current="page"]) {
    border-inline-start-color: var(--bw-indigo, #6366f1) !important;
    color: var(--bw-indigo, #6366f1) !important;
  }
</style>
